# PostgreSQL. On Vercel + Neon these two are filled in automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Optional direct connection for migrations (Neon on Vercel sets this automatically).
DATABASE_URL_UNPOOLED=""
# Set to true to load the demo companies and users on deploy (testing only).
SEED_DEMO=false
# Petty cash mobile app: reads receipt photos with Claude. Without it the app falls back to manual entry.
ANTHROPIC_API_KEY=""

{
  "name": "accounting-ph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate.mjs && node scripts/maybe-seed.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "exceljs": "^4.4.0",
    "next": "15.5.29",
    "pdf-lib": "1.17.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.19.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
